# Copy to .env for local development. In production (Railway, etc.) set these
# as real environment variables instead of committing a .env file.

# Set to "production" in any deployed environment (Railway also counts
# automatically). In production the server refuses to start with the dev
# JWT_SECRET/ADMIN_TOKEN below or any secret shorter than 32 characters.
APP_ENV=development

PORT=8080

# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/taela_ai?sslmode=disable

# Used to sign JWTs — generate a long random value for anything beyond local dev,
# e.g. `openssl rand -base64 48`
JWT_SECRET=dev-only-insecure-secret-change-me

# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000

# Shared secret required (as an X-Admin-Token header) to hit /api/admin/*
# endpoints, e.g. forcing a job-feed sync. Generate a real value for anything
# beyond local dev, e.g. `openssl rand -base64 32`
ADMIN_TOKEN=dev-only-admin-token-change-me

# How often (in minutes) the job catalog re-syncs from the external feed
JOB_SYNC_INTERVAL_MINUTES=30

# Base URL of the deployed Frontend — used to build the link inside
# password reset emails (e.g. https://app.taelahr.com)
FRONTEND_URL=http://localhost:3000

# --- Email (internal/email — see internal/email/README.md) ---

# Which provider internal/email sends through. "mailtrap" is the only one
# built in right now; see internal/email/README.md for adding another
# (Mailchimp, Mailjet, ...) — nothing outside internal/email changes.
EMAIL_PROVIDER=mailtrap

# Sender used for internal/transactional mail (password resets, welcome
# emails, application updates, ...).
EMAIL_FROM_ADDRESS=no-reply@taelahr.com
EMAIL_FROM_NAME=TaelaAI

# Sender used for marketing mail (product announcements, digests, ...).
# Leave blank to just reuse EMAIL_FROM_ADDRESS/EMAIL_FROM_NAME.
MARKETING_FROM_ADDRESS=
MARKETING_FROM_NAME=

# Mailtrap API token (Mailtrap dashboard → Settings → API Tokens). Leave
# blank for local dev — outgoing email is logged to the console instead of
# actually being sent.
MAILTRAP_API_TOKEN=

# false (default) sends for real. true routes every send — internal or
# marketing — into a Mailtrap Testing inbox (MAILTRAP_SANDBOX_ID) instead
# of delivering it, so it's safe to turn on for staging/CI.
MAILTRAP_SANDBOX=false
MAILTRAP_SANDBOX_ID=

# Comma-separated IPs/CIDRs of the reverse proxy in front of this API. Needed
# for the auth rate limiter to see real client IPs and not a spoofable header.
# Leave blank locally.
TRUSTED_PROXIES=

# --- CV storage (internal/storage) ---
# "r2" for Cloudflare R2 (or any S3-compatible bucket); "local" keeps files in
# STORAGE_LOCAL_DIR and is for development only. Blank means local outside
# production and *disabled* in production (uploads and guest applications
# return 503) so files are never written to a disk the next deploy wipes.
STORAGE_PROVIDER=
STORAGE_LOCAL_DIR=./data/uploads
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: override the endpoint for another S3-compatible service.
R2_ENDPOINT=

# --- AI (internal/ai) — reads uploaded CVs into editable sections ---
# anthropic | gemini | bedrock. Blank = uploads are stored but not read.
AI_PROVIDER=
# anthropic defaults to claude-haiku-5-5; gemini and bedrock need a model id.
AI_MODEL=
# Optional base URL for a gateway/proxy in front of the anthropic or gemini API.
AI_BASE_URL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# bedrock uses the standard AWS credential chain; set AWS_REGION too.
AWS_REGION=
