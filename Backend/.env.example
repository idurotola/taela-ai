# Copy to .env for local development. In production (Render, etc.) set these
# as real environment variables instead of committing a .env file.

PORT=8080

# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/taela_ai?sslmode=disable

# Used to sign JWTs — generate a long random value for anything beyond local dev,
# e.g. `openssl rand -base64 48`
JWT_SECRET=dev-only-insecure-secret-change-me

# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000

# Shared secret required (as an X-Admin-Token header) to hit /api/admin/*
# endpoints, e.g. forcing a job-feed sync. Generate a real value for anything
# beyond local dev, e.g. `openssl rand -base64 32`
ADMIN_TOKEN=dev-only-admin-token-change-me

# How often (in minutes) the job catalog re-syncs from the external feed
JOB_SYNC_INTERVAL_MINUTES=30
